# Copy to .env.local for local dev, and set the same values in your Vercel
# project (Settings -> Environment Variables). Leaving these unset runs the app
# in open "demo mode" with no login required.

# --- Client (safe to expose; bundled into the browser) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Email allowed to bootstrap the first admin account:
VITE_ADMIN_EMAIL=team@onestopprintco.com

# --- Server only (NEVER expose; used by the /api serverless functions) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
ADMIN_EMAIL=team@onestopprintco.com

# Optional: sending (review requests + automated birthday/holiday greetings).
# A Zapier "Catch Hook" webhook URL that routes to Gmail / an SMS app / etc.
ZAPIER_WEBHOOK_URL=
# Secret shared with the daily-greetings Vercel Cron job (any random string).
CRON_SECRET=

# Optional: live analytics sync. Full JSON of a Google service-account key with
# access to the GA4 Data API + Search Console API.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional: GoHighLevel — powers onboarding agreements (e-sign), and can back
# client messaging & calendars. Private Integration token + sub-account id.
GHL_API_KEY=
GHL_LOCATION_ID=
# Optional: the GHL workflow that sends/collects the agreement signature.
GHL_AGREEMENT_WORKFLOW_ID=
# Optional: GHL workflows for the onboarding sequence — a welcome sequence and
# a bio-collection questionnaire/form. Leave unset to just send the welcome SMS.
GHL_WELCOME_WORKFLOW_ID=
GHL_QUESTIONNAIRE_WORKFLOW_ID=

# Optional: Stripe — lets independent (non–Allied Elite Financial) advisors pay
# for premium features by subscription. Secret API key from the Stripe
# dashboard, and the signing secret for the /api/stripe/webhook endpoint.
# Until these are set, checkout no-ops and advisors fall back to "request access".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
